# JLAW Agent Platform — Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Anthropic API Key (required)
ANTHROPIC_API_KEY=sk-ant-api03-YOUR_KEY_HERE

# Proton Bridge Configuration (for secure email submissions)
PROTON_BRIDGE_HOST=127.0.0.1
PROTON_BRIDGE_SMTP_PORT=1025
PROTON_BRIDGE_IMAP_PORT=1143
PROTON_EMAIL=your-submission-address@proton.me
PROTON_PASSWORD=your-bridge-password

# Data Directories
JLAW_DATA_DIR=./data
JLAW_LOG_DIR=./logs

# Human Notification (for escalation alerts)
HUMAN_NOTIFICATION_EMAIL=your-personal-email@example.com
